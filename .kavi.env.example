# Kavi — per-machine environment variables.
#
# Copy this file to .kavi.env and edit the paths to match your machine:
#   cp .kavi.env.example .kavi.env
#
# Then load it before running anything that needs SDK/NDK paths:
#   bash / Git Bash / WSL:  source .kavi.env
#   PowerShell (Windows):   see the block at the bottom of this file
#
# .kavi.env is gitignored — never commit it.
#
# Each value below uses ${VAR:-default}, so a variable already exported in your
# shell (or inherited from Windows) wins over the default. A variable that is
# set but points nowhere is almost always a stale or corrupted value inherited
# from Windows (e.g. ANDROID_NDK_ROOT left as "%SDK%\ndk\26.1.10909125"), so
# drop it and fall back to the default instead of using the broken value:
if [ -n "${QAIRT_SDK_ROOT:-}" ] && [ ! -d "$QAIRT_SDK_ROOT" ]; then
	echo "[kavi.env] ignoring QAIRT_SDK_ROOT='$QAIRT_SDK_ROOT' (not a directory)" >&2
	unset QAIRT_SDK_ROOT
fi
if [ -n "${ANDROID_NDK_ROOT:-}" ] && [ ! -d "$ANDROID_NDK_ROOT" ]; then
	echo "[kavi.env] ignoring ANDROID_NDK_ROOT='$ANDROID_NDK_ROOT' (not a directory)" >&2
	unset ANDROID_NDK_ROOT
fi

# --- Windows (default) -------------------------------------------------------
# QAIRT lives outside the Android SDK. Both versions are pinned in .kavi.yaml
# (`sdk.qairt.version`, `sdk.ndk.version`); do not upgrade QAIRT — it must match
# the device qnn-2.31 / HTP v73 runtime.
export QAIRT_SDK_ROOT="${QAIRT_SDK_ROOT:-/c/Qualcomm/AIStack/QAIRT/2.31.0.250130}"
# The NDK lives inside the Android SDK root installed by the app repo's
# `scripts/setup-android-sdk.sh`; override it if your NDK is elsewhere.
export ANDROID_NDK_ROOT="${ANDROID_NDK_ROOT:-/c/android_sdk/ndk/26.1.10909125}"

# --- Linux / macOS -----------------------------------------------------------
# Uncomment these two and comment out the Windows exports above if your SDKs
# live under $HOME instead:
#
# export QAIRT_SDK_ROOT="${QAIRT_SDK_ROOT:-$HOME/Qualcomm/AIStack/QAIRT/2.31.0.250130}"
# export ANDROID_NDK_ROOT="${ANDROID_NDK_ROOT:-$HOME/Android/Sdk/ndk/26.1.10909125}"
#
# Under WSL the Windows SDKs are reachable at /mnt/c/..., e.g.
# /mnt/c/Qualcomm/AIStack/QAIRT/2.31.0.250130.

# --- Windows / PowerShell equivalent -----------------------------------------
# Git Bash on Windows can source this file as-is. In PowerShell, set the two
# variables directly, e.g.:
#
#   $env:QAIRT_SDK_ROOT   = "C:\Qualcomm\AIStack\QAIRT\2.31.0.250130"
#   $env:ANDROID_NDK_ROOT = "C:\android_sdk\ndk\26.1.10909125"
#
# For QAIRT conversion on Windows, dot-source scripts\qairt-env.ps1 instead.
# ----------------------------------------------------------------------------
