# Kavi — per-machine SDK/NDK roots.
#
# Everything *derived* from these two roots — the converter bin dir, the host
# library dir, the SDK envsetup flavour, and the Python 3.10 converter venv — is
# resolved by scripts/env.py, the single source of truth:
#
#   uv run python -m scripts.env --help
#
# This file therefore declares only where the SDKs live on *this* machine, and it
# is optional: with both variables unset, scripts/env.py probes the usual install
# locations (C:\Qualcomm, ~/Qualcomm, /mnt/c/Qualcomm, ...), which covers the
# reference machines. Copy it when your SDKs live somewhere else:
#
#   cp .kavi.env.example .kavi.env
#   source .kavi.env
#
# .kavi.env is gitignored — never commit it.
#
# Each value below uses ${VAR:-default}, so a variable already exported in your
# shell (or inherited from Windows) wins. A variable that is set but points
# nowhere is almost always a stale or corrupted value inherited from Windows, so
# drop it and let the probe decide instead of using the broken value:
if [ -n "${QAIRT_SDK_ROOT:-}" ] && [ ! -d "$QAIRT_SDK_ROOT" ]; then
	echo "[kavi.env] ignoring QAIRT_SDK_ROOT='$QAIRT_SDK_ROOT' (not a directory)" >&2
	unset QAIRT_SDK_ROOT
fi
if [ -n "${ANDROID_NDK_ROOT:-}" ] && [ ! -d "$ANDROID_NDK_ROOT" ]; then
	echo "[kavi.env] ignoring ANDROID_NDK_ROOT='$ANDROID_NDK_ROOT' (not a directory)" >&2
	unset ANDROID_NDK_ROOT
fi

# ── Windows (Git Bash / WSL / PowerShell spell the same roots differently) ────
export QAIRT_SDK_ROOT="${QAIRT_SDK_ROOT:-/c/Qualcomm/AIStack/QAIRT/2.31.0.250130}"
export ANDROID_NDK_ROOT="${ANDROID_NDK_ROOT:-/c/android_sdk/ndk/26.1.10909125}"

# ── Linux / macOS ────────────────────────────────────────────────────────────
# Uncomment these two and comment out the Windows exports above instead:
#
# export QAIRT_SDK_ROOT="${QAIRT_SDK_ROOT:-$HOME/Qualcomm/AIStack/QAIRT/2.31.0.250130}"
# export ANDROID_NDK_ROOT="${ANDROID_NDK_ROOT:-$HOME/Android/Sdk/ndk/26.1.10909125}"

# ── PowerShell equivalent (or dot-source scripts\qairt-env.ps1) ───────────────
#
#   $env:QAIRT_SDK_ROOT   = "C:\Qualcomm\AIStack\QAIRT\2.31.0.250130"
#   $env:ANDROID_NDK_ROOT = "C:\android_sdk\ndk\26.1.10909125"
#
# ----------------------------------------------------------------------------
